<Window x:Class="KiLupeDemo.Services.OrbOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ki-Lupe Schwebemodus"
        Width="520"
        Height="86"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="OrbButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#2C3B35" />
      <Setter Property="Foreground" Value="#EEF3EF" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="OrbBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="#51645B"
                    BorderThickness="1"
                    CornerRadius="22">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="OrbBorder" Property="Background" Value="#4A6356" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="OrbBorder" Property="Background" Value="#9AE6B4" />
                <Setter Property="Foreground" Value="#102019" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="4"
          Padding="10,7"
          Background="#E61A211E"
          BorderBrush="#9AE6B4"
          BorderThickness="1"
          CornerRadius="30">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Right"
                  Orientation="Horizontal"
                  VerticalAlignment="Center">
        <Button x:Name="PauseButton"
                Style="{StaticResource OrbButtonStyle}"
                Content="II"
                ToolTip="Pause/Fortsetzen"
                Click="PauseButton_Click" />
        <Button Style="{StaticResource OrbButtonStyle}"
          Content="C"
          ToolTip="Markierungen loeschen"
          Click="ClearButton_Click" />
        <Button x:Name="CorrectionButton"
          Style="{StaticResource OrbButtonStyle}"
          Content="K"
          IsEnabled="False"
          ToolTip="Korrekturvorschlag anzeigen"
          Click="CorrectionButton_Click" />
        <Button x:Name="ModeButton"
                Style="{StaticResource OrbButtonStyle}"
                Content="M"
                ToolTip="Analysemodus wechseln"
                Click="ModeButton_Click" />
        <Button Style="{StaticResource OrbButtonStyle}"
                Content="R"
                ToolTip="Treffer anzeigen"
                Click="ResultsButton_Click" />
        <Button Style="{StaticResource OrbButtonStyle}"
                Content="X"
                ToolTip="Schwebemodus beenden"
                Click="ExitButton_Click" />
      </StackPanel>

      <StackPanel VerticalAlignment="Center"
                  Margin="4,0,12,0">
        <TextBlock x:Name="ModeText"
                   Text="Objekte / Cursor"
                   Foreground="#9AE6B4"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText"
                   Text="Bereit"
                   Foreground="#C4D0CB"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DockPanel>
  </Border>
</Window>