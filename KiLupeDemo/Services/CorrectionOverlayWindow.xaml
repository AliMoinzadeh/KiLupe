<Window x:Class="KiLupeDemo.Services.CorrectionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ki-Lupe Korrekturvorschlag"
        Width="430"
        Height="245"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True">
  <Border Margin="4"
          Padding="12"
          Background="#ED1A211E"
          BorderBrush="#9AE6B4"
          BorderThickness="1"
          CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <Button DockPanel.Dock="Right"
                Content="X"
                Padding="8,3"
                ToolTip="Korrektur ausblenden"
                Click="HideButton_Click" />
        <TextBlock Text="KORREKTURVORSCHLAG"
                   Foreground="#9AE6B4"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="OriginalText"
                 Grid.Row="1"
                 Margin="0,8,0,6"
                 Foreground="#C4D0CB"
                 TextWrapping="Wrap" />
      <TextBox x:Name="SuggestionTextBox"
               Grid.Row="2"
               MinHeight="80"
               Padding="8"
               AcceptsReturn="True"
               Background="#0E1713"
               BorderBrush="#51645B"
               Foreground="#EEF3EF"
               IsReadOnly="True"
               TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" />
      <DockPanel Grid.Row="3" Margin="0,8,0,0">
        <TextBlock x:Name="StatusText"
                   Foreground="#9AA9A4"
                   FontSize="11"
                   TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal">
          <Button x:Name="CopySelectionButton"
                  Content="Auswahl kopieren"
                  Padding="8,4"
                  ToolTip="Markierten Vorschlag kopieren"
                  Click="CopySelectionButton_Click" />
          <Button x:Name="CopyButton"
                  Content="Alles kopieren"
                  Padding="8,4"
                  ToolTip="Gesamten Vorschlag kopieren"
                  Click="CopyButton_Click" />
        </StackPanel>
      </DockPanel>
    </Grid>
  </Border>
</Window>
