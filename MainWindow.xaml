<Window x:Class="KiLupeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ki-Lupe"
        Width="1280"
        Height="780"
        MinWidth="900"
        MinHeight="560"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="#EEF3EF"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#102019" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#EEF3EF" />
      <Setter Property="Background" Value="#2C3B35" />
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Padding="16,12"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="KI-LUPE"
                     FontFamily="Georgia"
                     FontSize="24"
                     FontWeight="Bold" />
          <TextBlock Text="Lokale Bild- und Texterkennung"
                     Foreground="#9AA9A4"
                     FontSize="12" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Content="Bild oeffnen"
                  Click="OpenImage_Click" />
          <Button Content="Textdatei laden"
            Click="OpenTextFile_Click" />
          <Button Content="Text speichern unter" Click="SaveTextFile_Click" />
          <Button Content="Objekte suchen"
                  Click="AnalyzeObjects_Click" />
          <Button Content="Text pruefen"
                  Click="AnalyzeText_Click" />
          <Button Content="Schwebemodus"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Click="FloatingMode_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

        <Grid x:Name="WorkspaceGrid"
          Grid.Row="1"
          Margin="0,14,0,14"
          SizeChanged="WorkspaceGrid_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0"
              Background="#0C1210"
              BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              Padding="10">
        <Grid x:Name="LeftWorkspaceGrid">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="ImageWorkspaceRow"
                           Height="*"
                           MinHeight="160" />
            <RowDefinition x:Name="CorrectionSplitterRow"
                           Height="0" />
            <RowDefinition x:Name="CorrectionRow"
                           Height="0" />
          </Grid.RowDefinitions>

          <Grid x:Name="ImageSurface"
                Grid.Row="0"
                Background="#14201B"
                MouseMove="ImageSurface_MouseMove"
                MouseLeave="ImageSurface_MouseLeave"
                SizeChanged="ImageSurface_SizeChanged">
            <TextBlock x:Name="EmptyStateText"
                       Text="Oeffne ein Bild, um die Lupe zu starten."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#9AA9A4"
                       FontSize="16" />
            <AdornerDecorator x:Name="TextDocumentDecorator" Visibility="Collapsed">
                <TextBox x:Name="WorkspaceTextDocument"
                   TextChanged="WorkspaceTextDocument_TextChanged"
                   IsInactiveSelectionHighlightEnabled="True"
                   SelectionBrush="Yellow"
                   Padding="16"
                   Background="#101814"
                   BorderThickness="0"
                   Foreground="#EEF3EF"
                   FontSize="14"
                   HorizontalScrollBarVisibility="Disabled"
                   IsReadOnly="False"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalContentAlignment="Top"
                   VerticalScrollBarVisibility="Auto"
                   Visibility="Collapsed" />
            </AdornerDecorator>
            <Image x:Name="WorkspaceImage"
                   Stretch="Uniform"
                 Visibility="Collapsed"
                   SnapsToDevicePixels="True" />
            <Canvas x:Name="ResultsCanvas"
                  Visibility="Collapsed"
                    IsHitTestVisible="False" />
            <Canvas x:Name="MagnifierLayer"
                  Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10">
              <Border x:Name="Magnifier"
                      Width="168"
                      Height="168"
                      Visibility="Collapsed"
                      BorderBrush="#9AE6B4"
                      BorderThickness="4"
                      Background="#101614">
                <Border.Clip>
                  <EllipseGeometry Center="84,84" RadiusX="84" RadiusY="84" />
                </Border.Clip>
                <Image x:Name="MagnifierImage"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
            </Canvas>
          </Grid>

          <GridSplitter x:Name="CorrectionGridSplitter"
                        Grid.Row="1"
                        Height="7"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#51645B"
                        Cursor="SizeNS"
                        DragCompleted="CorrectionGridSplitter_DragCompleted"
                        ResizeBehavior="PreviousAndNext"
                        ResizeDirection="Rows"
                        ShowsPreview="False"
                        Visibility="Collapsed" />

          <Border x:Name="CorrectionPanel"
                  Grid.Row="2"
                  Padding="12"
                  Background="#E61A211E"
                  BorderBrush="#9AE6B4"
                  BorderThickness="1"
                  CornerRadius="8"
                  Visibility="Collapsed">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Right"
                        Content="X"
                        Padding="8,3"
                        ToolTip="Korrektur ausblenden"
                        Click="HideCorrectionButton_Click" />
                <TextBlock Text="KORREKTURVORSCHLAG"
                           Foreground="#9AE6B4"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock x:Name="CorrectionOriginalText"
                         Grid.Row="1"
                         Margin="0,8,0,6"
                         Foreground="#C4D0CB"
                         TextWrapping="Wrap" />
              <TextBox x:Name="CorrectionSuggestionTextBox"
                       Grid.Row="2"
                       MinHeight="80"
                       Padding="8"
                       AcceptsReturn="True"
                       Background="#0E1713"
                       BorderBrush="#51645B"
                       Foreground="#EEF3EF"
                       HorizontalScrollBarVisibility="Disabled"
                       IsReadOnly="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" />
              <TextBlock x:Name="CorrectionStatusText"
                         Grid.Row="3"
                         Margin="0,8,0,0"
                         Foreground="#9AA9A4"
                         FontSize="11"
                         TextWrapping="Wrap" />
              <StackPanel Grid.Row="4"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Right"
                          Orientation="Horizontal">
                <Button x:Name="CopyCorrectionSelectionButton"
                        Content="Auswahl kopieren"
                        Padding="8,4"
                        ToolTip="Markierten Vorschlag kopieren"
                        Click="CopyCorrectionSelectionButton_Click" />
                <Button x:Name="CopyCorrectionButton"
                        Content="Alles kopieren"
                        Padding="8,4"
                        ToolTip="Gesamten Vorschlag kopieren"
                        Click="CopyCorrectionButton_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Margin="14,0,0,0"
              Padding="16"
              Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="AKTUELLE TREFFER"
                       Foreground="#9AA9A4"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ResultCountText"
                       Text="Noch keine Analyse"
                       Margin="0,4,0,12"
                       FontFamily="Georgia"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock Text="MODELLE"
                       Foreground="#9AA9A4"
                       FontSize="11"
                       FontWeight="SemiBold" />
            <TextBlock Text="Objektmodell"
                       Margin="0,7,0,3"
                       Foreground="#C4D0CB"
                       FontSize="11" />
            <ComboBox x:Name="ObjectModelSelector"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ModelSelector_SelectionChanged"
                      Background="#1B2923"
                      Foreground="#102019" />
            <TextBlock Text="Textkorrektur"
                       Margin="0,7,0,3"
                       Foreground="#C4D0CB"
                       FontSize="11" />
            <ComboBox x:Name="TextCorrectionSelector"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ModelSelector_SelectionChanged"
                      Background="#1B2923"
                      Foreground="#102019" />
            <CheckBox x:Name="ContextAwareCorrectionCheckBox"
                      Content="Kontextabhängig korrigieren"
                      Margin="0,8,0,3"
                      Foreground="#C4D0CB"
                      Checked="ContextAwareCorrection_Changed"
                      Unchecked="ContextAwareCorrection_Changed"
                      ToolTip="Für das lokale LLM: Beschriftungen und Textfragmente nur auf Tippfehler prüfen; Grammatik nur bei klarem Satzkontext. Gilt auch für Bilder." />
            <TextBlock Text="Ausfuehrung"
                       Margin="0,7,0,3"
                       Foreground="#C4D0CB"
                       FontSize="11" />
            <ComboBox x:Name="ProviderSelector"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="ModelSelector_SelectionChanged"
                      Background="#1B2923"
                      Foreground="#102019" />
            <Button Content="Vorhersagemodus ..." Click="PredictionSettings_Click"
                    Margin="0,0,0,5" Padding="8,5" />
            <TextBlock x:Name="PredictionStatusText" Text="Vorhersage ausgeschaltet."
                       TextWrapping="Wrap" Foreground="#9AA9A4" FontSize="11" Margin="0,0,0,10" />
            <TextBlock x:Name="ModelStatusText"
                       Margin="0,7,0,12"
                       Foreground="#9AA9A4"
                       FontSize="11"
                       TextWrapping="Wrap" />
          </StackPanel>
          <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="#EEF3EF"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8"
                        Padding="10"
                        Background="#223029"
                        CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Label}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Confidence, StringFormat={}{0:P0}}"
                               Foreground="#9AE6B4"
                               Margin="8,0,0,0" />
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Kind}"
                               Margin="0,3,0,0"
                               Foreground="#9AA9A4"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2"
                               Grid.ColumnSpan="2"
                               Text="{Binding Details}"
                               Margin="0,4,0,0"
                               Foreground="#C4D0CB"
                               TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

    </Grid>

    <Border Grid.Row="2"
            Padding="12,9"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
      <DockPanel>
        <CheckBox x:Name="PresentationModeCheckBox"
                  DockPanel.Dock="Right"
                  Content="Video-Call"
                  Foreground="#EEF3EF"
                  Margin="12,0,0,0"
                  ToolTip="Markierungen in Bildschirmfreigaben anzeigen. Den ganzen Bildschirm teilen."
                  Checked="PresentationMode_Changed"
                  Unchecked="PresentationMode_Changed" />
        <TextBlock Text="STATUS"
                   Foreground="#9AA9A4"
                   FontSize="11"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText"
                   Margin="12,0,0,0"
                   Text="Bereit."
                   Foreground="#C4D0CB" />
      </DockPanel>
    </Border>
  </Grid>
</Window>